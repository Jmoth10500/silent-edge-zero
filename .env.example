# Copy to .env (already gitignored — never commit real credentials)

# The Racing API — free tier, HTTP Basic Auth (username + password, not a
# bearer token). Get these from theracingapi.com -> "Get Started Free" ->
# your account dashboard -> API Keys. See docs/FREE_DATA_SOURCES.md #3.
THERACINGAPI_USERNAME=
THERACINGAPI_PASSWORD=

# Betfair Exchange API — free Delayed App Key (developer.betfair.com ->
# Exchange API -> Accounts API Demo Tool -> createDeveloperAppKeys). Needs
# your regular betfair.com login (username + password) for session login,
# NOT just the app key, per Betfair's real login flow — see
# docs/FREE_DATA_SOURCES.md #4.
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_DELAYED_APP_KEY=
